# --- Central database (docker-compose sets this automatically) ---
DATABASE_URL=postgresql+psycopg2://backup_console:backup_console@db:5432/backup_console

# --- Real connector credentials (not required for the mock MVP) ---
# Populate these when swapping a mock connector for a live one; wire them
# into the relevant connector's __init__ in backend/app/connectors/.

# Rubrik Security Cloud
RUBRIK_RSC_ENDPOINT=
RUBRIK_RSC_CLIENT_ID=
RUBRIK_RSC_CLIENT_SECRET=

# Veeam Enterprise Manager
VEEAM_EM_ENDPOINT=
VEEAM_EM_USERNAME=
VEEAM_EM_PASSWORD=

# Commvault
COMMVAULT_WEBCONSOLE_ENDPOINT=
COMMVAULT_USERNAME=
COMMVAULT_PASSWORD=

# Azure Backup (Recovery Services)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
